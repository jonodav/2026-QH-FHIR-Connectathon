{
    "Fhir": {
        "BaseUrl": "https://referrals.efiq.hospservices.net/fhir",
        "PageSize": 100,
        "SearchParameters": [
            "status=requested",
            "owner=Organization/bathurst-pathology",
            "intent=order"
        ]
    },
    "ConnectionStrings": {
        "OrdersDatabase": "Data Source=pathology-orders.db"
    },
    "Hl7": {
        "Transport": "Mllp",
        "Host": "127.0.0.1",
        "Port": 2575,
        "ConnectTimeout": "00:00:10",
        "AcknowledgementTimeout": "00:00:30",
        "HttpUrl": "http://127.0.0.1:8080/hl7",
        "HttpContentType": "x-application/hl7-v2+er7",
        "PollInterval": "00:00:05",
        "MaximumAttempts": 10,
        "BatchSize": 20
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Information",
            "Microsoft.Hosting.Lifetime": "Information",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    }
}